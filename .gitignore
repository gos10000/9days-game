# ============================================================
# Unity 项目 .gitignore
# 基于 GitHub 官方 Unity 模板（github.com/github/gitignore）
# ============================================================

# ---------- Unity 自动生成目录（绝对不要提交）----------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Assets 下的 .meta 必须提交，不能被上面的规则误伤
!/[Aa]ssets/**/*.meta

# ---------- IDE / 自动生成的工程文件 ----------
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------- Unity 生成的 meta 文件 ----------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------- 崩溃报告 ----------
sysinfo.txt

# ---------- 打包产物 ----------
*.apk
*.aab
*.unitypackage
*.app

# ---------- Crashlytics ----------
crashlytics-build.properties

# ---------- 操作系统 / 编辑器杂项 ----------
.DS_Store
Thumbs.db
.vs/
.idea/
